# User unit, not system: the agent inventories this user's packages and reads
# this user's credential paths. Install to ~/.config/systemd/user/ then:
#   systemctl --user enable --now pkgwatch-agent
#   loginctl enable-linger $USER     # so it survives logout

[Unit]
Description=pkgwatch agent
Documentation=https://github.com/myselfvivek17/pkgwatch
After=network-online.target

# The agent gates installs. If it cannot start, that must be loud rather than a
# silent open door, so failures restart forever instead of tripping systemd's
# start-rate limit and leaving the unit disabled.
#
# This belongs in [Unit], not [Service]. It was in the wrong section and systemd
# ignored it with a warning nobody reads, which left the default in force: five
# restarts in ten seconds and then it gives up permanently. Exactly the
# behaviour the setting exists to prevent.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/.local/bin/pkgwatch agent

# always, not on-failure. systemd restarts on a non-zero status, a signal, a
# timeout or a watchdog — and does nothing at all when the process exits 0. For
# something that is only ever supposed to be running, exit 0 is not success, it
# is the service being gone. The Windows side of this fleet had the same hole
# and the gate stayed down for seven hours with the task reporting green.
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
